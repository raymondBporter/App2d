<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AnalysisModePerformance>All</AnalysisModePerformance>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\App2d.Core\App2d.Core.csproj" />
    <ProjectReference Include="..\App2d.Tiles\App2d.Tiles.csproj" />
    <ProjectReference Include="..\App2d.Rendering\App2d.Rendering.csproj" />
    <ProjectReference Include="..\App2d.Audio\App2d.Audio.csproj" />
    <ProjectReference Include="..\App2d.Gameplay\App2d.Gameplay.csproj" />
    <ProjectReference Include="..\App2d.Game.Presentation\App2d.Game.Presentation.csproj" />
    <ProjectReference Include="..\App2d.Levels\App2d.Levels.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Assets\Runtime\**\*"
          Exclude="..\Assets\Runtime\audio\music\**\*;..\Assets\Runtime\levels\**\zones.json"
          Link="Assets\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToPublishDirectory="PreserveNewest">
      <CopyToOutputDirectory Condition="'$(Configuration)' == 'Debug'">Never</CopyToOutputDirectory>
      <CopyToOutputDirectory Condition="'$(Configuration)' != 'Debug'">PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- These committed files can arrive through git pull after the art pipeline
         last ran. Package them directly, including on the first build. -->
    <None Include="..\Assets\Static\audio\music\**\*"
          Link="Assets\audio\music\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToPublishDirectory="PreserveNewest">
      <CopyToOutputDirectory Condition="'$(Configuration)' == 'Debug'">Never</CopyToOutputDirectory>
      <CopyToOutputDirectory Condition="'$(Configuration)' != 'Debug'">PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\Assets\Static\levels\**\zones.json"
          Link="Assets\levels\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToPublishDirectory="PreserveNewest">
      <CopyToOutputDirectory Condition="'$(Configuration)' == 'Debug'">Never</CopyToOutputDirectory>
      <CopyToOutputDirectory Condition="'$(Configuration)' != 'Debug'">PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <None Include="..\Assets\Characters\authored\**\*.json" Link="Assets\PointCharacters\authored\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="ValidateRuntimeAssets" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('..\Assets\Runtime\content-manifest.json')"
           Text="Runtime assets are missing. Run: python tools/ArtPipeline/build_runtime_assets.py" />
  </Target>

  <Target Name="ResetReleaseAssetsOutput"
          AfterTargets="GetCopyToOutputDirectoryItems"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(Configuration)' != 'Debug'">
    <RemoveDir Directories="$(OutDir)Assets" />
  </Target>

  <Target Name="ResetPublishedAssetsOutput"
          BeforeTargets="PrepareForPublish"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(PublishDir)' != ''">
    <RemoveDir Directories="$(PublishDir)Assets" />
  </Target>

</Project>
