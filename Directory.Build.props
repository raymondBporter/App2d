<Project>
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevelPerformance>latest-all</AnalysisLevelPerformance>
  </PropertyGroup>

  <!-- Share aliases across projects that use the runtime math and rendering types. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'App2d.Analyzers' and '$(MSBuildProjectName)' != 'App2d.Analyzers.CodeFixes'">
    <Using Include="App2d.Core.Mathematics" />
    <Using Include="App2d.Core.Mathematics.Progress.ProgressMap&lt;float&gt;" Alias="ProgressMapf" />
    <Using Include="App2d.Core.Mathematics.Progress.ProgressMap&lt;double&gt;" Alias="ProgressMapd" />
    <Using Include="App2d.Core.Mathematics.Progress.Easing&lt;float&gt;" Alias="Easingf" />
    <Using Include="App2d.Core.Mathematics.Progress.Easing&lt;double&gt;" Alias="Easingd" />
    <Using Include="App2d.Core.Mathematics.Real&lt;float&gt;" Alias="Realf" />
    <Using Include="App2d.Core.Mathematics.Real&lt;double&gt;" Alias="Reald" />
    <Using Include="Microsoft.Xna.Framework.Color" Alias="Color4b" />
    <Using Include="App2d.Core.Mathematics.Vector2f" Alias="Vector2f" />
    <Using Include="App2d.Core.Mathematics.Vector2d" Alias="Vector2d" />
    <Using Include="App2d.Core.Geometry.Primitives.IRect2&lt;App2d.Core.Mathematics.Vector2f, float&gt;" Alias="IRect2f" />
    <Using Include="App2d.Core.Geometry.Primitives.IRect2&lt;App2d.Core.Mathematics.Vector2d, double&gt;" Alias="IRect2d" />
    <Using Include="App2d.Core.Geometry.Primitives.Rect2&lt;App2d.Core.Mathematics.Vector2d, double&gt;" Alias="Rect2d" />
    <Using Include="App2d.Core.Mathematics.Vector3f" Alias="Vector3f" />
    <Using Include="App2d.Core.Mathematics.Matrix2x2&lt;App2d.Core.Mathematics.Vector2f, float&gt;" Alias="Matrix2x2f" />
    <Using Include="App2d.Core.Mathematics.Matrix2x2&lt;App2d.Core.Mathematics.Vector2d, double&gt;" Alias="Matrix2x2d" />
  </ItemGroup>

  <!-- Analyzer references are build/editor tools, never runtime references. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'App2d.Analyzers' and '$(MSBuildProjectName)' != 'App2d.Analyzers.CodeFixes' and '$(MSBuildProjectName)' != 'App2d.Analyzers.Tests'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)App2d.Analyzers/App2d.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)App2d.Analyzers.CodeFixes/App2d.Analyzers.CodeFixes.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
