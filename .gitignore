*.nupkg
*.snupkg
artifacts/
Assets/Work/
/Assets/Runtime/

/Assets/Sources/third-party/rgs-stick-figure.zip
/Assets/Sources/third-party/rgs-stick-figure/*.blend

# Keep downloaded image/video model weights out of source control.
# Tool scripts and small reference assets can be committed; installations,
# caches, and generated runs belong under the ignored Assets/Work directory.
*.safetensors
*.gguf
*.ckpt

# Maaot permits the art in games but forbids redistributing the asset packs.
# Keep the locally downloaded source archives and generated runtime slices out
# of source control; rebuild them with tools/ArtPipeline/build_runtime_assets.py.
/Assets/Sources/third-party/maaot/*.zip

# SQLite leaves transient WAL/SHM files beside a level database; only the .db is durable.
Assets/Static/levels/**/*.db-wal
Assets/Static/levels/**/*.db-shm
