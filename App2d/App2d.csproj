<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AnalysisModePerformance>All</AnalysisModePerformance>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp.Views.WindowsForms" Version="4.151.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\App2d.Core\App2d.Core.csproj" />
    <ProjectReference Include="..\App2d.Collision\App2d.Collision.csproj" />
    <ProjectReference Include="..\App2d.Tiles\App2d.Tiles.csproj" />
    <ProjectReference Include="..\App2d.Physics\App2d.Physics.csproj" />
    <ProjectReference Include="..\App2d.Rendering\App2d.Rendering.csproj" />
    <ProjectReference Include="..\App2d.Audio\App2d.Audio.csproj" />
    <ProjectReference Include="..\App2d.Gameplay\App2d.Gameplay.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Assets\Content\**\*"
          Link="Assets\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="ResetRuntimeAssetsOutput"
          AfterTargets="GetCopyToOutputDirectoryItems"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <RemoveDir Directories="$(OutDir)Assets" />
  </Target>

</Project>
