<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AnalysisModePerformance>All</AnalysisModePerformance>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\App2d\ArgGuard.cs" Link="ArgGuard.cs" />
    <Compile Include="..\App2d\StateGuard.cs" Link="StateGuard.cs" />
    <Compile Include="..\App2d\Engine\FrameTime.cs" Link="Engine\FrameTime.cs" />
    <Compile Include="..\App2d\Engine\SpatialObject2D.cs" Link="Engine\SpatialObject2D.cs" />
    <Compile Include="..\App2d\Engine\Animation\**\*.cs" Link="Engine\Animation\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\App2d\Engine\Collision\**\*.cs"
             Exclude="..\App2d\Engine\Collision\Queries\RaycastQueries2D.cs"
             Link="Engine\Collision\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\App2d\Engine\Geometry\**\*.cs" Link="Engine\Geometry\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\App2d\Engine\Mathematics\**\*.cs" Link="Engine\Mathematics\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\App2d\Engine\Tiles\**\*.cs" Link="Engine\Tiles\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
